#-------------
#---Startup---
#-------------
exec_once=waybar
exec_once=./autostart.sh

#-------------
#----Input----
#-------------
# Teclado
numlock_on=1
xkb_rules_layout=br
xkb_rules_variant=thinkpad

#Trackpad
trackpad_natural_scrolling=1

#-------------
#----Binds----
#-------------
bind=Super,return,spawn,foot
bind=Super,space,spawn,rofi -config ~/.config/mango.back/rofi/config.rasi -show drun

bind=Super,r,reload_config
bind=Super,q,killclient,
bind=Super,n,switch_layout

bind=Super,h,focusdir,left
bind=Super,l,focusdir,right
bind=Super,k,focusdir,up
bind=Super,j,focusdir,down

bind=Super,Tab,togglejump
bind=ALT,Tab,overcircle,next
#-------------
#---Layouts---
#-------------
tag_rule=id:*,layout_name:scroller
circle_layout=scroller